{
  "name": "sala-nera",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:seed": "node --env-file=.env.local scripts/seed-portal.mjs",
    "activity": "node --env-file=.env.local scripts/activity.mjs",
    "rates:doc": "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON scripts/rates-doc.mjs",
    "check:rates": "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/ts-alias-hook.mjs scripts/check-rates.mjs",
    "check:sigv4": "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON scripts/check-sigv4.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.10",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "drizzle-kit": "^0.31.10",
    "typescript": "^7.0.2"
  }
}
